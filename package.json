{
	"name": "mocke",
	"type": "module",
	"scripts": {
		"start": "node dist/index.js",
		"build": "tsup src/index.ts --no-splitting --no-sourcemap --clean --minify --format esm && cp -r src/assets dist/assets",
		"dev": "tsx --watch src/index.ts",
		"lint": "biome check --write . && tsc --noEmit"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.8",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.5.0",
		"csv-parse": "^7.0.1",
		"hono": "^4.12.30",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/node": "^26.1.1",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
